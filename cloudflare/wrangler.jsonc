{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "treasure-island-conquest",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbx8hf-8OPmgPqdrVURm9S_YaxPG8WERbx7U45Pr_6BpA2NhaR5cV9EXvA3ZnM8ly0zfrA/exec"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}