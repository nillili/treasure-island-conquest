# 의존성
node_modules/
.wrangler/

# 비밀값 — Apps Script 와 주고받는 공유 비밀. 절대 올리지 않는다.
.dev.vars
*.dev.vars

# 감시·시험 도구가 쓰는 선생님 세션 쿠키. 브라우저에서 꺼낸 값이라 그대로 로그인이 된다.
*.cookie

# 운영 DB 백업 — 선생님 계정·퀴즈 전체. 절대 올리지 않는다
backups/

# 수업 로그 — 학생 실명이 들어 있다
logs/

# 작업 대화 기록 — 비밀값·관리자 비밀번호가 그대로 들어 있다
sessions/
docs/sessions/
cloudflare/sessions/

# 편집기·OS
.DS_Store
*.swp

# wrangler 가 만들어 주는 런타임 타입(540KB). npm run types 로 언제든 다시 만든다.
worker-configuration.d.ts
