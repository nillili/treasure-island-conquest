# 이 파일을 .dev.vars 로 복사해서 쓴다. .dev.vars 는 절대 커밋하지 않는다.

# 네오버스 SSO — 보물섬 전용 클라이언트 시크릿. 네오버스 쪽 등록 값과 같아야 한다.
# 나머지 값(NEOBUS_ORIGIN · MERGE_CLIENT_ID · MERGE_REDIRECT_URI)은 비밀이 아니므로
# wrangler.jsonc 의 vars 에 둔다.
MERGE_CLIENT_SECRET=여기에-시크릿

# 로컬 개발용 — tools/fake-neobus.mjs 를 가리킨다(실서버 값은 wrangler.jsonc 의 vars).
NEOBUS_ORIGIN=http://127.0.0.1:8798
MERGE_CLIENT_ID=treasure-island-v2
MERGE_REDIRECT_URI=http://127.0.0.1:8799/auth/callback
